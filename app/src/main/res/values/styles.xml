<resources>
    <style name="Theme.Tijario.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tijario_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/tijario_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Tijario</item>
        <item name="android:windowBackground">@color/tijario_splash_background</item>
        <item name="android:statusBarColor">@color/tijario_splash_background</item>
        <item name="android:navigationBarColor">@color/tijario_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Tijario" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F7FAFC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7FAFC</item>
        <item name="android:navigationBarColor">#F7FAFC</item>
        <item name="android:fontFamily">sans</item>
    </style>
</resources>
